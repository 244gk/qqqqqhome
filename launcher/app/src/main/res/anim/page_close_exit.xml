<?xml version="1.0" encoding="utf-8"?>
<!-- A page closing: shrinks slightly to 96% while fading out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic"
    android:shareInterpolator="true"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="200" />
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="200" />
</set>
